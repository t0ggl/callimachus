{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "ignorePresets": [
    "docker:pinDigests"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)Dockerfile(\\.[^/]+)?$/"
    ]
  },
  "prHourlyLimit": 4,
  "automerge": true,
  "labels": [
    "dependencies"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "npmDedupe"
  ],
  "packageRules": [
    {
      "description": "Pin Dockerfile images by digest and merge after CI passes",
      "matchManagers": ["dockerfile"],
      "pinDigests": true,
      "platformAutomerge": false
    },
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group non-major frontend devDependencies updates",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "web devDependencies (non-major)",
      "minimumReleaseAge": "7 days"
    }
  ]
}
